<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cita para los osos</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
<style>
:root{--bg:#0f2230;--bg2:#15332d;--card:#eadfc8;--ink:#1c2b2a;--gold:#c9a961;--soft:#b9ad95;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:linear-gradient(160deg,var(--bg),var(--bg2));color:var(--card);font-family:Jost,system-ui,sans-serif;overflow-x:hidden}
#app{min-height:100%;max-width:520px;margin:0 auto;padding:20px 20px 28px;display:flex;flex-direction:column}
h1,h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;margin:0;line-height:1.1}
h1{font-size:2.6rem}h2{font-size:1.9rem}
p{line-height:1.55;margin:0}
.top{display:flex;align-items:center;gap:12px;height:36px;margin-bottom:22px}
.back{background:none;border:1px solid var(--gold);color:var(--gold);width:36px;height:36px;border-radius:50%;font-size:1.1rem;cursor:pointer;flex:none}
.back[hidden]{visibility:hidden;display:block}
.bar{flex:1;height:4px;background:#ffffff22;border-radius:4px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--gold);transition:width .5s ease}
.screen{flex:1;display:flex;flex-direction:column;justify-content:center;gap:18px;animation:in .45s ease}
@keyframes in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.sub{color:var(--soft);font-size:.95rem}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.opt{background:var(--card);color:var(--ink);border:2px solid transparent;border-radius:16px;padding:16px 10px;text-align:center;font:500 .95rem Jost,sans-serif;cursor:pointer;min-height:104px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;transition:transform .2s,border-color .2s,background .2s}
.opt b{font-size:1.9rem;font-weight:400}
.opt.sel{border-color:var(--gold);background:#f6ecd3;transform:scale(1.03);box-shadow:0 0 0 3px #c9a96155}
.wide{grid-column:1/-1;min-height:84px}
textarea{width:100%;min-height:140px;border-radius:16px;border:2px solid var(--gold);background:var(--card);color:var(--ink);font:1rem Jost,sans-serif;padding:14px;resize:none}
.btn{background:var(--gold);color:#1a2622;border:0;border-radius:999px;padding:15px 22px;font:500 1rem Jost,sans-serif;cursor:pointer;text-align:center;text-decoration:none;display:block}
.btn:disabled{opacity:.35}
.ghost{background:none;border:1px solid var(--gold);color:var(--gold)}
.center{text-align:center;align-items:center}
.bears{line-height:0}
.sum{background:var(--card);color:var(--ink);border-radius:18px;padding:6px 18px}
.row{padding:12px 0;border-bottom:1px solid #1c2b2a22}
.row:last-child{border:0}
.row small{display:block;color:#6b6552;font-size:.8rem;margin-bottom:2px}
.sig{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:1.4rem;color:var(--gold)}
canvas{position:fixed;inset:0;pointer-events:none;z-index:9}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head>
<body><div id="app"></div><canvas id="cf"></canvas>
<script>
const Q=[
{k:'Actividad',t:'¿Qué te apetece hacer, oso?',s:'Elige todos los que quieras.',max:9,o:[['🥾','Paseo por la montaña'],['🍣','Picnic con xuxi y poke bowl'],['🎾','Sesión de pádel'],['🤸','Ir al Salting'],['🎮','Videojuego juntos'],['🍳','Cocinar una receta juntos'],['💆','Sesión de beauty y masaje']],wide:6},
{k:'Lugar',t:'¿Dónde lo hacemos?',s:'Puedes elegir más de uno.',max:9,o:[['⛰️','Montaña'],['🌿','Campo'],['🏙️','Ciudad'],['🏠','En casa']]},
{k:'Vestimenta',t:'¿Cómo vamos vestidos?',s:'Puedes elegir más de uno.',max:9,o:[['😎','Flow'],['🕴️','Elegante'],['🩳','Cómodo']],wide:2},
{k:'Música',t:'¿Qué suena de fondo?',s:'Elige las que quieras para nuestra banda sonora.',max:9,o:[['🏰','Canciones de Disney'],['🎤','Canciones de Drake'],['🦸','Canciones de Marvel']],wide:2},
{k:'Extra',t:'¿Algo que quieras añadir a nuestra cita?',s:'Lo que se te ocurra, es tu momento.',open:1}
];
const BEARS='<svg viewBox="0 0 200 72" width="200" role="img" aria-label="Oso y osa"><g transform="translate(0,0)"><circle cx="21" cy="15" r="11" fill="#b3763f"/><circle cx="69" cy="15" r="11" fill="#b3763f"/><circle cx="21" cy="15" r="5.5" fill="#efd9b0"/><circle cx="69" cy="15" r="5.5" fill="#efd9b0"/><circle cx="45" cy="40" r="30" fill="#b3763f"/><ellipse cx="45" cy="50" rx="14" ry="11" fill="#efd9b0"/><circle cx="34" cy="36" r="3.4" fill="#2b1d14"/><circle cx="56" cy="36" r="3.4" fill="#2b1d14"/><ellipse cx="45" cy="45" rx="5.2" ry="3.5" fill="#2b1d14"/><path d="M45 48v4M39 54q6 4 12 0" stroke="#2b1d14" stroke-width="2" fill="none" stroke-linecap="round"/></g><g transform="translate(108,0)"><circle cx="21" cy="15" r="11" fill="#b3763f"/><circle cx="69" cy="15" r="11" fill="#b3763f"/><circle cx="21" cy="15" r="5.5" fill="#efd9b0"/><circle cx="69" cy="15" r="5.5" fill="#efd9b0"/><circle cx="45" cy="40" r="30" fill="#b3763f"/><ellipse cx="45" cy="50" rx="14" ry="11" fill="#efd9b0"/><circle cx="34" cy="36" r="3.4" fill="#2b1d14"/><circle cx="56" cy="36" r="3.4" fill="#2b1d14"/><ellipse cx="45" cy="45" rx="5.2" ry="3.5" fill="#2b1d14"/><path d="M45 48v4M39 54q6 4 12 0" stroke="#2b1d14" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M66 14L44 2v24z" fill="#ec6fa0"/><path d="M66 14l22-12v24z" fill="#ec6fa0"/><circle cx="66" cy="14" r="6.5" fill="#d63f7d"/></g></svg>';const A=[];let step=0;const app=document.getElementById('app');
const esc=s=>s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function topbar(){const n=Q.length;return `<div class="top"><button class="back" ${step==0||step>n?'hidden':''} onclick="go(-1)" aria-label="Atrás">‹</button><div class="bar"><i style="width:${Math.min(step,n)/n*100}%"></i></div></div>`}
function render(){
 if(step==0){app.innerHTML=`<div class="screen center"><div class="bears">${BEARS}</div><h1>Cita para los osos</h1><p>Tu nena te ha preparado un súper plan. Cinco preguntitas y queda listo.</p><p class="sub">Desde el 30/03/2016 · te quiero 3000</p><button class="btn" onclick="go(1)">Empezar</button></div>`;return}
 const n=Q.length;
 if(step<=n){const q=Q[step-1],a=A[step-1]||(A[step-1]=[]);
  let body;
  if(q.open){body=`<textarea id="txt" placeholder="Escribe aquí, oso…" oninput="A[${step-1}]=[this.value]">${esc(a[0]||'')}</textarea>`}
  else body=`<div class="grid">${q.o.map((o,i)=>`<button class="opt ${a.includes(o[1])?'sel':''} ${i==q.wide?'wide':''}" onclick="pick(${i})"><b>${o[0]}</b>${o[1]}</button>`).join('')}</div>`;
  app.innerHTML=topbar()+`<div class="screen"><div><h2>${q.t}</h2><p class="sub" style="margin-top:8px">${q.s}</p></div>${body}<button class="btn" id="nx" onclick="go(1)" ${!q.open&&!a.length?'disabled':''}>${step==n?'Ver nuestro plan':'Siguiente'}</button></div>`;return}
 summary()}
function pick(i){const q=Q[step-1],v=q.o[i][1],a=A[step-1];
 if(a.includes(v))a.splice(a.indexOf(v),1);else{if(a.length>=q.max)a.shift();a.push(v)}
 render()}
function go(d){step+=d;render();if(step>Q.length)confetti()}
function txt(){const g=i=>(A[i]||[]).join(' + ');const ex=(A[4]&&A[4][0]||'').trim();
 return `¡Hola, nena! Mis respuestas para nuestra cita 💛\n\nActividad: ${g(0)}\nLugar: ${g(1)}\nVestimenta: ${g(2)}\nMúsica: ${g(3)}\nExtra: ${ex||'nada, ¡sorpréndeme!'}\n\nTe quiero 3000 💛`}
function summary(){
 const g=i=>(A[i]||[]).join(' + ');const ex=(A[4]&&A[4][0]||'').trim();
 const rows=[['Actividad',g(0)],['Lugar',g(1)],['Vestimenta',g(2)],['Música',g(3)]];if(ex)rows.push(['Tu extra',esc(ex)]);
 app.innerHTML=topbar()+`<div class="screen"><div class="center" style="text-align:center"><div class="bears">${BEARS}</div><h2>Nuestro plan, oso</h2><p class="sub" style="margin-top:8px">Cita de los osos, ya oficial</p></div>
 <div class="sum">${rows.map(r=>`<div class="row"><small>${r[0]}</small>${r[1]}</div>`).join('')}</div>
 <p style="text-align:center">Diez años y medio desde el 30/03/2016, y lo mejor sigue siendo hacer planes contigo.</p>
 <p class="sig" style="text-align:center">Te quiero 3000<br>Tu osa<svg viewBox="0 0 90 60" width="34" style="vertical-align:-8px;margin-left:6px"><circle cx="21" cy="15" r="11" fill="#b3763f"/><circle cx="69" cy="15" r="11" fill="#b3763f"/><circle cx="21" cy="15" r="5.5" fill="#efd9b0"/><circle cx="69" cy="15" r="5.5" fill="#efd9b0"/><circle cx="45" cy="38" r="28" fill="#b3763f"/><ellipse cx="45" cy="47" rx="13" ry="10" fill="#efd9b0"/><circle cx="35" cy="34" r="3.3" fill="#2b1d14"/><circle cx="55" cy="34" r="3.3" fill="#2b1d14"/><ellipse cx="45" cy="43" rx="5" ry="3.4" fill="#2b1d14"/><path d="M64 14L44 3v22z" fill="#ec6fa0"/><path d="M64 14l20-11v22z" fill="#ec6fa0"/><circle cx="64" cy="14" r="6" fill="#d63f7d"/></svg></p>
 <a class="btn" target="_blank" href="https://wa.me/34693706836?text=${encodeURIComponent(txt())}">Enviar mis respuestas</a>
 <button class="btn ghost" onclick="confetti()">Más confeti</button></div>`}
function confetti(){const c=document.getElementById('cf'),x=c.getContext('2d');c.width=innerWidth;c.height=innerHeight;
 if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
 const cols=['#c9a961','#eadfc8','#e3c98a','#f6ecd3'];
 const p=Array.from({length:110},()=>({x:Math.random()*c.width,y:-20-Math.random()*c.height*.5,w:5+Math.random()*6,h:8+Math.random()*8,vy:1.5+Math.random()*3,vx:Math.random()*2-1,r:Math.random()*6,vr:Math.random()*.2-.1,c:cols[Math.random()*4|0]}));
 let f=0;(function d(){x.clearRect(0,0,c.width,c.height);p.forEach(a=>{a.x+=a.vx;a.y+=a.vy;a.r+=a.vr;x.save();x.translate(a.x,a.y);x.rotate(a.r);x.fillStyle=a.c;x.fillRect(-a.w/2,-a.h/2,a.w,a.h);x.restore()});if(++f<320)requestAnimationFrame(d);else x.clearRect(0,0,c.width,c.height)})()}
render();
</script></body></html>
